# Maps Embed API — iframe fallback (cropped, no extra UI when static is off).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
#
# Maps Static API — styled preview without Google’s info card (enable in Cloud Console,
# then set both lines below). Preview loads via /api/static-map so the key stays server-side.
# GOOGLE_MAPS_API_KEY=same_or_server_restricted_key
# NEXT_PUBLIC_MAPS_STATIC_PREVIEW=1
